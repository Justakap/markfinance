# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/backend/node_modules
/.pnp
.pnp.js

# backend is its own independent git repository (github.com/Justakap/markfinancebackend),
# checked out locally inside this working tree for convenience. It must never be tracked
# here as a file/submodule — doing so previously created an orphaned gitlink entry with no
# .gitmodules registration, which broke Netlify's clone ("No url found for submodule path
# 'backend' in .gitmodules"). If you need it versioned alongside this repo, use a proper
# `git submodule add`, not a bare `git add backend`.
/backend

# testing
/coverage
/backend/coverage

# production
/build
/backend/dist

# misc
.DS_Store
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
.npm
.cache

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# logs
*.log

